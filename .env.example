# Copy to .env.local for local development. Deployments read these from Vercel.

# Sanity. The site reads content on the server with a token, so the dataset
# can be private. Use a Viewer token here; SANITY_WRITE_TOKEN is used if empty.
SANITY_API_READ_TOKEN=
# Editor token for saving form submissions and chat sessions.
SANITY_WRITE_TOKEN=

# Form notification emails (Resend).
RESEND_API_KEY=

# Mochi chat (OpenAI).
OPENAI_API_KEY=

# Shared secret for the booking confirmation webhook (Google Apps Script).
BOOKING_WEBHOOK_SECRET=

# Protects the one-off chatbot FAQ seeding endpoint.
SEED_SECRET=

# Site URL for canonical links and the sitemap. Defaults to https://www.elixderm.com.
NEXT_PUBLIC_BASE_URL=
